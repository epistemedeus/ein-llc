{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ein.llc/schemas/einllc.agent-authority.v1.schema.json",
  "title": "EIN.LLC agent authority letter, version 1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "einllc.agent-authority.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-HJ-NP-Z2-9]{8}$"
    },
    "check": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://ein\\.llc/letter\\?n=[A-HJ-NP-Z2-9]{8}(#k=[A-Za-z0-9_-]{22})?$"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legalName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "jurisdiction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 83,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "entityType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "entityNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        }
      },
      "required": [
        "legalName",
        "entityType"
      ]
    },
    "companyProvenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "formed-through-ein"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "signer-stated"
            },
            "emailDomain": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"
            }
          },
          "required": [
            "kind"
          ]
        }
      ]
    },
    "signedBy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "title": {
          "enum": [
            "Member",
            "Managing member",
            "Manager",
            "President",
            "Director",
            "Secretary",
            "Managing director",
            "Owner",
            "Partner"
          ]
        },
        "at": {
          "oneOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name",
        "title",
        "at"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "reference": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "operator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
        },
        "role": {
          "const": "agent"
        },
        "isOwnerOrOfficer": {
          "const": false
        },
        "maySign": {
          "const": false
        }
      },
      "required": [
        "name",
        "reference",
        "role",
        "isOwnerOrOfficer",
        "maySign"
      ]
    },
    "may": {
      "type": "array",
      "items": {
        "enum": [
          "quote",
          "order",
          "sell",
          "pay",
          "refund",
          "terms",
          "correspond",
          "documents"
        ]
      },
      "uniqueItems": true,
      "maxItems": 8
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "USD"
        },
        "perTransaction": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "perMonth": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "currency",
        "perTransaction",
        "perMonth"
      ]
    },
    "counterparties": {
      "oneOf": [
        {
          "const": "any"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
          }
        }
      ]
    },
    "needsPerson": {
      "type": "array",
      "items": {
        "enum": [
          "contract",
          "account",
          "hire",
          "over-limit",
          "new-counterparty"
        ]
      },
      "uniqueItems": true,
      "maxItems": 5
    },
    "validFrom": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "validUntil": {
      "type": "string",
      "format": "date",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "grantsAccessToMoneyOrAccounts": {
      "const": false
    }
  },
  "required": [
    "schema",
    "id",
    "check",
    "issuer",
    "signedBy",
    "agent",
    "may",
    "limits",
    "counterparties",
    "needsPerson",
    "validFrom",
    "validUntil",
    "grantsAccessToMoneyOrAccounts"
  ]
}
