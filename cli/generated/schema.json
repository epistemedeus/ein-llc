          "yes": {
            "type": "boolean",
            "description": "Confirm this command's effect (provisional_application_write)."
          },
          "confirm-effect": {
            "type": "string",
            "enum": [
              "anonymous_record_write",
              "provisional_application_write"
            ],
            "description": "Confirm by naming the exact effect."
          },
          "task-file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Continuation record (mode 0600). Default EIN_CONTINUATION_FILE."
          },
          "intended-email": {
            "type": "string",
            "minLength": 3,
            "maxLength": 320,
            "description": "Human recipient who will claim. Default EIN_CONTINUATION_INTENDED_EMAIL."
          }
